matches = na.omit(match(geotrichum_candidum$Geneid, annotation$gene))
geotrichum_candidum$KO = annotation$KO[matches]
ordered = order(rowSums(geotrichum_candidum[-c(1, 2, 37)]), decreasing=TRUE)
geotrichum_candidum = geotrichum_candidum[ordered, ]
duplicated_KO = duplicated(geotrichum_candidum$KO)
geotrichum_candidum = geotrichum_candidum[!duplicated_KO, ]
kluyveromyces_lactis = ecostab_backup[startsWith(ecostab_backup$Geneid, "KLLA"), ]
rownames(kluyveromyces_lactis) = NULL
matches = na.omit(match(kl_annotation$gene, kluyveromyces_lactis$Geneid))
kluyveromyces_lactis = kluyveromyces_lactis[matches, ]
matches = na.omit(match(kluyveromyces_lactis$Geneid, kl_annotation$gene))
kluyveromyces_lactis$KO = kl_annotation$KO[matches]
ordered = order(rowSums(kluyveromyces_lactis[-c(1, 2, 37)]), decreasing=TRUE)
kluyveromyces_lactis = kluyveromyces_lactis[ordered, ]
duplicated_KO = duplicated(kluyveromyces_lactis$KO)
kluyveromyces_lactis = kluyveromyces_lactis[!duplicated_KO, ]
# Remove lowly expressed genes (8353 genes):
ga_design = DGEList(counts = glutamicibacter_arilaitensis[, -c(1, 2, 37)], group = groups)
rownames(ga_design) = glutamicibacter_arilaitensis$KO
highly_expressed_genes = filterByExpr(ga_design)
ga_filtered = ga_design[highly_expressed_genes, , keep.lib.sizes = FALSE]
ga_normalized = calcNormFactors(ga_filtered, method = "TMM")
ba_design = DGEList(counts = brevibacterium_aurantiacum[, -c(1, 2, 37)], group = groups)
rownames(ba_design) = brevibacterium_aurantiacum$KO
highly_expressed_genes = filterByExpr(ba_design)
ba_filtered = ba_design[highly_expressed_genes, , keep.lib.sizes = FALSE]
ba_normalized = calcNormFactors(ba_filtered, method = "TMM")
cc_design = DGEList(counts = corynebacterium_casei[, -c(1, 2, 37)], group = groups)
rownames(cc_design) = corynebacterium_casei$KO
highly_expressed_genes = filterByExpr(cc_design)
cc_filtered = cc_design[highly_expressed_genes, , keep.lib.sizes = FALSE]
cc_normalized = calcNormFactors(cc_filtered, method = "TMM")
ha_design = DGEList(counts = hafnia_alvei[, -c(1, 2, 37)], group = groups)
rownames(ha_design) = hafnia_alvei$KO
highly_expressed_genes = filterByExpr(ha_design)
ha_filtered = ha_design[highly_expressed_genes, , keep.lib.sizes = FALSE]
ha_normalized = calcNormFactors(ha_filtered, method = "TMM")
ll_design = DGEList(counts = lactococcus_lactis[, -c(1, 2, 37)], group = groups)
rownames(ll_design) = lactococcus_lactis$KO
highly_expressed_genes = filterByExpr(ll_design)
ll_filtered = ll_design[highly_expressed_genes, , keep.lib.sizes = FALSE]
ll_normalized = calcNormFactors(ll_filtered, method = "TMM")
se_design = DGEList(counts = staphylococcus_equorum[, -c(1, 2, 37)], group = groups)
rownames(se_design) = staphylococcus_equorum$KO
highly_expressed_genes = filterByExpr(se_design)
se_filtered = se_design[highly_expressed_genes, , keep.lib.sizes = FALSE]
se_normalized = calcNormFactors(se_filtered, method = "TMM")
dh_design = DGEList(counts = debaryomyces_hansenii[, -c(1, 2, 26:37)], group = DT_groups)
rownames(dh_design) = debaryomyces_hansenii$KO
highly_expressed_genes = filterByExpr(dh_design)
dh_filtered = dh_design[highly_expressed_genes, , keep.lib.sizes = FALSE]
dh_normalized = calcNormFactors(dh_filtered, method = "TMM")
gc_design = DGEList(counts = geotrichum_candidum[, -c(1, 2, 14:25, 37)], group = GT_groups)
rownames(gc_design) = geotrichum_candidum$KO
highly_expressed_genes = filterByExpr(gc_design)
gc_filtered = gc_design[highly_expressed_genes, , keep.lib.sizes = FALSE]
gc_normalized = calcNormFactors(gc_filtered, method = "TMM")
kl_design = DGEList(counts = kluyveromyces_lactis[, -c(1, 2, 37)], group = groups)
rownames(kl_design) = kluyveromyces_lactis$KO
highly_expressed_genes = filterByExpr(kl_design)
kl_filtered = kl_design[highly_expressed_genes, , keep.lib.sizes = FALSE]
kl_normalized = calcNormFactors(kl_filtered, method = "TMM")
# Export the normalized data
normalized_matrices = list(cpm(ga_normalized), cpm(ba_normalized), cpm(cc_normalized), cpm(ha_normalized),
cpm(ll_normalized), cpm(se_normalized), cpm(dh_normalized), cpm(gc_normalized),
cpm(kl_normalized))
names(normalized_matrices) = as.character(substitute(c(ga_normalized, ba_normalized,
cc_normalized, ha_normalized,
ll_normalized, se_normalized,
dh_normalized, gc_normalized,
kl_normalized)))[-1]
names(normalized_matrices) = as.character(substitute(c(ga_normalized, ba_normalized,
cc_normalized, ha_normalized,
ll_normalized, se_normalized,
dh_normalized, gc_normalized,
kl_normalized)))[-1]
View(normalized_matrices)
525+128+579+1070+480+435+1545+1837+1611
# Create the merged RNA-Seq dataset:
DT_cols = matrix(0, ncol = 11, nrow = dim(normalized_matrices$dh_normalized)[1])
colnames(DT_cols) = colnames(normalized_matrices$ga_normalized)[24:34]
GT_cols = matrix(0, ncol = 12, nrow = dim(normalized_matrices$gc_normalized)[1])
colnames(GT_cols) = colnames(normalized_matrices$ga_normalized)[12:23]
dh_tmp = cbind(normalized_matrices$dh_normalized, DT_cols)
gc_tmp = cbind(normalized_matrices$gc_normalized[, 1:11],
GT_cols,
normalized_matrices$gc_normalized[, 12:22])
merged_rnaseq = t(rbind(normalized_matrices$ga_normalized,
normalized_matrices$ba_normalized,
normalized_matrices$cc_normalized,
normalized_matrices$ha_normalized,
normalized_matrices$ll_normalized,
normalized_matrices$se_normalized,
dh_tmp,
gc_tmp,
normalized_matrices$kl_normalized))
# Detection of orthologous genes:
orthologous_genes = unique(colnames(merged_rnaseq)[duplicated(colnames(merged_rnaseq))])
# Summing up of the orthologous genes:
global_rnaseq = merged_rnaseq
col_vect = NULL
for (i in 1:length(orthologous_genes)) {
gene_indices = which(orthologous_genes[i] == colnames(global_rnaseq))
sum_vector = rowSums(global_rnaseq[, gene_indices])
global_rnaseq = cbind(global_rnaseq, sum_vector)
col_vect = c(col_vect, which(orthologous_genes[i] == colnames(global_rnaseq)))
}
global_rnaseq = global_rnaseq[, -col_vect]
colnames(global_rnaseq)[grepl("sum", colnames(global_rnaseq))] = orthologous_genes
dim(global_rnaseq)
