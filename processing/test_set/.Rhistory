brevibacterium_aurantiacum = brevibacterium_aurantiacum[ordered, ]
duplicated_KO = duplicated(brevibacterium_aurantiacum$KO)
brevibacterium_aurantiacum = brevibacterium_aurantiacum[!duplicated_KO, ]
